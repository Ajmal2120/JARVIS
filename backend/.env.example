# J.A.R.V.I.S. Configuration
# Copy this file to .env and fill in your values

# --- LLM Provider Configuration ---
# Set to 'claude' (default) or 'gemini'
LLM_PROVIDER=claude

# Anthropic API key (REQUIRED if LLM_PROVIDER=claude) - get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-opm-I-h9khSq3rPaB571UoQyeY5eaBP63B6r
ANTHROPIC_BASE_URL=https://api.opusmax.pro

# Claude model to use (when LLM_PROVIDER=claude)
CLAUDE_MODEL=claude-sonnet-4-6

# Gemini API key (REQUIRED if LLM_PROVIDER=gemini) - get from https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# How JARVIS addresses you
JARVIS_USER_NAME=Sir

# Your timezone (IANA format)
JARVIS_TIMEZONE=Asia/Kolkata

# Your default location (lat,lon) for weather briefings
DEFAULT_LAT=26.4499
DEFAULT_LON=80.3319

# Voice settings
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Proactivity
PROACTIVITY_ENABLED=true
PROACTIVITY_TICK_MINUTES=15
REFLECTION_INTERVAL_HOURS=6

# Server
HOST=127.0.0.1
PORT=8000